{
  "id": "rpcs3",
  "name": "RPCS3",
  "systems": [
    "ps3"
  ],
  "github": "RPCS3/rpcs3-binaries-linux",
  "asset_suffix": "linux64.appimage",
  "asset_excludes": [],
  "binary": "AppRun",
  "config_subdir": "rpcs3",
  "requirement": "Install PS3 firmware through Firmware setup. Verified base-disc ISOs launch directly in the managed RPCS3 profile; game compatibility varies.",
  "firmware": [
    {
      "name": "PS3UPDAT.PUP",
      "required": true,
      "root": "config",
      "dir": "rpcs3/firmware",
      "note": "Use reviewed Firmware setup to install this package into RPCS3. Files in the inbox are stored packages, not proof of installed firmware."
    }
  ],
  "kind": "emulator",
  "launch": [
    "--no-gui",
    "{rom}"
  ],
  "fullscreen_args": [
    "--fullscreen"
  ],
  "settings": [
    {
      "path": "rpcs3/GuiConfigs/CurrentSettings.ini",
      "section": "main_window",
      "key": "confirmationBoxExitGame",
      "value": "false"
    },
    {
      "path": "rpcs3/GuiConfigs/CurrentSettings.ini",
      "section": "GSFrame",
      "key": "hideMouseOnIdle",
      "value": "true"
    }
  ],
  "seed": [
    {
      "path": "rpcs3/custom_configs/config_BLES00932.yml",
      "contents": "Video:\n  Write Color Buffers: true\n"
    },
    {
      "path": "rpcs3/custom_configs/config_BCES00129.yml",
      "contents": "Video:\n  Write Color Buffers: true\n"
    },
    {
      "path": "rpcs3/custom_configs/config_NPEA80017.yml",
      "contents": "Video:\n  Write Color Buffers: true\n"
    },
    {
      "path": "rpcs3/custom_configs/config_BCES00006.yml",
      "contents": "Video:\n  Write Color Buffers: true\n"
    }
  ]
}
