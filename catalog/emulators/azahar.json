{
  "id": "azahar",
  "name": "Azahar",
  "systems": [
    "3ds"
  ],
  "github": "azahar-emu/azahar",
  "asset_suffix": "azahar.appimage",
  "asset_excludes": [],
  "binary": "AppRun",
  "config_subdir": "azahar",
  "requirement": "Nintendo 3DS emulator. Library Play runs decrypted cartridge dumps (.3ds/.cci/.cxi) and homebrew (.3dsx); encrypted dumps do not boot. Saves and settings stay in Marquee's Azahar folder.",
  "kind": "emulator",
  "launch": [
    "{rom}"
  ],
  "fullscreen_args": [
    "-f"
  ],
  "windowed_args": [
    "-w"
  ],
  "settings": [
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "showStatusBar",
      "value": "false"
    },
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "showStatusBar\\default",
      "value": "false"
    },
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "displayTitleBars",
      "value": "false"
    },
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "displayTitleBars\\default",
      "value": "false"
    },
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "confirmClose",
      "value": "false"
    },
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "confirmClose\\default",
      "value": "false"
    },
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "enable_discord_presence",
      "value": "false"
    },
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "enable_discord_presence\\default",
      "value": "false"
    },
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "hideInactiveMouse",
      "value": "true"
    },
    {
      "path": "azahar-emu/qt-config.ini",
      "section": "UI",
      "key": "hideInactiveMouse\\default",
      "value": "false"
    }
  ]
}
