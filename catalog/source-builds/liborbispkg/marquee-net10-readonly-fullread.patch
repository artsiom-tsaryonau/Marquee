@@ -1,4 +1,4 @@
-﻿using System;
+using System;
 using System.Runtime.InteropServices;
 using System.IO.MemoryMappedFiles;
 using System.IO;
@@ -84,7 +84,16 @@ namespace LibOrbisPkg.PFS
         using (var bufStream = new MemoryStream(sectorBuf))
         using (var ds = new DeflateStream(bufStream, CompressionMode.Decompress))
         {
-          ds.Read(output, 0, hdr.BlockSz);
+          // .NET 6+ DeflateStream.Read may return less than asked: read until full.
+          int filled = 0;
+          while (filled < hdr.BlockSz)
+          {
+            int n = ds.Read(output, filled, hdr.BlockSz - filled);
+            if (n == 0) break;
+            filled += n;
+          }
+          if (filled < hdr.BlockSz)
+            Array.Clear(output, filled, hdr.BlockSz - filled);
         }
       }
     }
