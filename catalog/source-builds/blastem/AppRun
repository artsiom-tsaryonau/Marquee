#!/bin/bash
set -euo pipefail
# The immutable local image contains both the compiled emulator and its libraries.
dir=$(cd -- "$(dirname -- "$0")" && pwd)
image=$(cat "$dir/image-id")
[[ "$image" =~ ^sha256:[a-f0-9]{64}$ ]] || { echo 'Invalid BlastEm image receipt' >&2; exit 1; }
# Podman uses the host's XDG directories for its image store and config.
# Keep the emulator paths in shell variables and forward them into the container.
config=${XDG_CONFIG_HOME:-}
data=${XDG_DATA_HOME:-}
cache=${XDG_CACHE_HOME:-}
for name in XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME; do
    flag="MARQUEE_HOST_${name}_SET"
    value="MARQUEE_HOST_${name}"
    if [[ ${!flag:-0} = 1 ]]; then
        export "$name=${!value}"
    else
        unset "$name"
    fi
done
# Version probes exit before initializing SDL.
if [[ $# = 1 && $1 = --version ]]; then
    exec podman run --rm --pull=never --network=none "$image" blastem -v
fi
: "${config:?Marquee must set XDG_CONFIG_HOME}" "${data:?Marquee must set XDG_DATA_HOME}" "${cache:?Marquee must set XDG_CACHE_HOME}"
mkdir -p "$config" "$data" "$cache"
args=(run --env SDL_RENDER_DRIVER=software --rm --init --pull=never --network=none --userns=keep-id --cap-drop=all
    --security-opt=no-new-privileges --security-opt=label=disable
    --env HOME=/tmp/marquee-home --env "XDG_CONFIG_HOME=$config" --env "XDG_DATA_HOME=$data"
    --env "XDG_CACHE_HOME=$cache" --env DISPLAY --env WAYLAND_DISPLAY --env XAUTHORITY
    --env XDG_RUNTIME_DIR --env PULSE_SERVER --env QT_QPA_PLATFORM
    --volume "$config:$config:rw"
    --volume "$data:$data:rw" --volume "$cache:$cache:rw")
# Prefer the compositor socket already forwarded below. X11 MIT-SHM can fail
# across private IPC namespaces; do not widen IPC access just to render a game.
if [[ -n ${SDL_VIDEODRIVER:-} ]]; then
    args+=(--env "SDL_VIDEODRIVER=$SDL_VIDEODRIVER")
elif [[ -n ${WAYLAND_DISPLAY:-} && -n ${XDG_RUNTIME_DIR:-} && -S $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ]]; then
    args+=(--env SDL_VIDEODRIVER=wayland)
fi
if [[ -d /tmp/.X11-unix ]]; then args+=(--volume /tmp/.X11-unix:/tmp/.X11-unix:ro); fi
if [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR ]]; then
    # A private user-owned runtime directory, with only selected host sockets.
    # Pre-create pulse as the mapped user; otherwise Podman creates its parent
    # as namespace root and libpulse refuses the directory as insecure.
    mkdir -p "$cache/runtime-v2/pulse"
    chmod 700 "$cache/runtime-v2" "$cache/runtime-v2/pulse"
    args+=(--volume "$cache/runtime-v2:$XDG_RUNTIME_DIR:rw")
    for socket in "${WAYLAND_DISPLAY:-wayland-0}" pulse/native pipewire-0; do
        if [[ -S $XDG_RUNTIME_DIR/$socket ]]; then
            args+=(--volume "$XDG_RUNTIME_DIR/$socket:$XDG_RUNTIME_DIR/$socket:ro")
        fi
    done
fi
if [[ -n ${XAUTHORITY:-} && -f $XAUTHORITY ]]; then args+=(--volume "$XAUTHORITY:$XAUTHORITY:ro"); fi
# Use the SDL software renderer as the portable baseline; no host GPU driver
# or OpenGL swap-interval support is required.
# BlastEm uses HOME rather than XDG on Linux. Map its two fixed directories
# onto the same isolated config/data folders that Marquee exposes through XDG.
mkdir -p "$config/blastem" "$data/blastem"
args+=(--volume "$config:/tmp/marquee-home/.config:rw"
    --volume "$data:/tmp/marquee-home/.local/share:rw")
for arg in "$@"; do
    if [[ $arg = /* && -f $arg ]]; then
        args+=(--volume "$arg:$arg:ro")
    fi
done
# Keep the last attempt's diagnostics outside the game/save directories. A
# regular file lets the game outlive Marquee; piping output through the launcher
# would instead risk SIGPIPE when its window closes. mktemp creates mode 600.
launch_log=$(mktemp "$cache/blastem-launch.XXXXXX")
exec >"$launch_log" 2>&1
mv -T -- "$launch_log" "$cache/blastem-last-launch.log"
exec podman "${args[@]}" "$image" blastem -g "$@"
