{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marquee",
  "version": "0.0.0",
  "identifier": "dev.marquee.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cargo build --locked -p marquee-manager && pnpm dev",
    "beforeBuildCommand": "cargo build --release --locked -p marquee-manager && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marquee",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#07070d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://127.0.0.1:* asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' http://127.0.0.1:*; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/marquee/art/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
