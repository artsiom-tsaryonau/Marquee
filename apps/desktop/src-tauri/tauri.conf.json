{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marquee",
  "version": "0.0.0",
  "identifier": "dev.marquee.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir .. dev",
    "beforeBuildCommand": "pnpm --dir .. build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marquee",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
