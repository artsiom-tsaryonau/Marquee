node_modules/
dist/
target/
.DS_Store

# Local secrets (API keys); never commit
.env
.env.*
!.env.example

# Locally fetched game images (ROMs, disc images) and their unpacked archives.
# Never committed: copyrighted/third-party media stays on this machine.
roms/

# BIOS dumps and other copyrighted firmware must never be committed
*.zip
*.bin
*.rom
*.7z
bios/

# samples and generated catalog dumps
sample/
data/

# Vault connectors live in fmhy-marquee-scrapers (clone separately)
scripts/vimm/

# Emulators are downloaded by Marquee into its own data folder, never committed.
# catalog/emulators/*.json (the download recipes) stay tracked.
runners/
bios-inbox/
firmware/
*.AppImage
*.tar.gz
*.tgz
*.[pP][uU][pP]
*.qcow2
*.nvmem
# Saves, states and memory cards an emulator writes
*.sav
*.srm
*.state
*.mcd
*.rar

# Game images anywhere in the repo (only roms/ is meant to hold them, and it is ignored)
*.iso
*.chd
*.cue
*.cdi
*.gdi
*.nes
*.sfc
*.smc
*.gb
*.gbc
*.z64
*.n64
*.v64
*.pce
*.smd
*.ngp
*.nds

# Local databases and their backups (the real library lives outside the repo)
*.db
*.db-wal
*.db-shm
*.db.bak*

# Build, tooling and log output
*.log
.svelte-kit/
.vite/
coverage/
*.tsbuildinfo
.pnpm-store/

# Signing keys and certificates
*.pem
*.key

# Torrent files made for the library live in the data dir, not the repo
*.torrent

# Local acceptance collection, including console key material; never commit.
sample_images/
